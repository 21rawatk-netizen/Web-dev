<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Portfolio</title>

<style>
:root {
    --bg-color: #ffffff;
    --text-color: #222;
    --card-color: #f4f4f4;
    --button-color: #4f46e5;
}

body.dark {
    --bg-color: #1e1e1e;
    --text-color: #ffffff;
    --card-color: #2c2c2c;
    --button-color: #6366f1;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: var(--bg-color);
    color: var(--text-color);
    transition: 0.3s ease;
}

/* Navbar */
nav {
    display: flex;
    justify-content: space-between;
    padding: 20px 40px;
    background: var(--card-color);
}

nav h1 {
    font-size: 24px;
}

.toggle-btn {
    padding: 8px 15px;
    border: none;
    cursor: pointer;
    border-radius: 20px;
    background: var(--button-color);
    color: white;
}

/* Hero Section */
.hero {
    text-align: center;
    padding: 80px 20px;
}

.hero h2 {
    font-size: 36px;
    margin-bottom: 15px;
}

.hero p {
    max-width: 500px;
    margin: auto;
    margin-bottom: 20px;
}

.hero button {
    padding: 10px 20px;
    border: none;
    border-radius: 25px;
    background: var(--button-color);
    color: white;
    cursor: pointer;
    transition: 0.3s;
}

.hero button:hover {
    opacity: 0.8;
}

/* Cards Section */
.projects {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 40px;
    flex-wrap: wrap;
}

.card {
    background: var(--card-color);
    padding: 20px;
    width: 250px;
    border-radius: 15px;
    text-align: center;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);
}

footer {
    text-align: center;
    padding: 20px;
    background: var(--card-color);
}

/* Responsive */
@media(max-width: 768px){
    .projects {
        flex-direction: column;
        align-items: center;
    }
}
</style>
</head>

<body>

<nav>
    <h1>MyPortfolio</h1>
    <button class="toggle-btn" onclick="toggleTheme()">Toggle Mode</button>
</nav>

<section class="hero">
    <h2>Hello, I'm Santusht 👋</h2>
    <p>A passionate web developer building modern and responsive websites.</p>
    <button onclick="showMessage()">Hire Me</button>
</section>

<section class="projects">
    <div class="card">
        <h3>Project 1</h3>
        <p>Responsive Website Design</p>
    </div>
    <div class="card">
        <h3>Project 2</h3>
        <p>JavaScript App</p>
    </div>
    <div class="card">
        <h3>Project 3</h3>
        <p>Full Stack Application</p>
    </div>
</section>

<footer>
    © 2026 Santusht | All Rights Reserved
</footer>

<script>
// Toggle Dark/Light Mode
function toggleTheme() {
    document.body.classList.toggle("dark");

    if(document.body.classList.contains("dark")){
        localStorage.setItem("theme", "dark");
    } else {
        localStorage.setItem("theme", "light");
    }
}

// Load saved theme
window.onload = function() {
    const savedTheme = localStorage.getItem("theme");
    if(savedTheme === "dark"){
        document.body.classList.add("dark");
    }
}

// Button Alert
function showMessage(){
    alert("Thank you for visiting my portfolio!");
}
</script>

</body>
</html>
